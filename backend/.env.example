# Copy to backend/.env and fill in. Every key is optional; defaults live in app/config.py.
# All variables are prefixed BOXMIND_.

# ── LLM provider ──
# "gateway" (default): the OpenAI-compatible HTTP gateway below.
# "claude_code": spawn the local `claude -p` CLI and bill its Claude subscription (personal test server only;
#   no ASR/TTS — the iOS app does both on-device). Needs `claude` installed and logged in for this user.
BOXMIND_LLM_PROVIDER=gateway
BOXMIND_CLAUDE_BIN=                     # empty = PATH, then ~/.local/bin/claude
BOXMIND_CLAUDE_MODEL=sonnet             # chat / interpret / agent
BOXMIND_CLAUDE_VISION_MODEL=sonnet      # photo intake
BOXMIND_CLAUDE_CONCURRENCY=3

# ── LLM gateway (OpenAI-compatible: /chat/completions, /audio/*, /embeddings) ──
# Default is https://api.getbot.me/v1 (my own gateway). Any OpenAI-compatible endpoint works.
BOXMIND_LLM_BASE_URL=https://api.getbot.me/v1
BOXMIND_LLM_API_KEY=sk-...
BOXMIND_LLM_MODEL=kimi-k2.5             # chat + function calling
BOXMIND_VISION_MODEL=kimi-k2.5          # photo intake (image input on /chat/completions)
BOXMIND_ASR_MODEL=qwen3-asr-flash-realtime
BOXMIND_TTS_MODEL=qwen3-tts-flash
BOXMIND_TTS_VOICE=alloy

# ── Database (docker compose exposes pgvector on 5434) ──
BOXMIND_DATABASE_URL=postgresql+psycopg://boxmind:boxmind@127.0.0.1:5434/boxmind

# ── Embeddings: "local" runs fastembed in-process (default), "remote" calls the gateway ──
BOXMIND_EMBEDDING_PROVIDER=local
BOXMIND_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
BOXMIND_EMBEDDING_DIM=384
# Persistent dir for the downloaded weights (~500 MB). Empty = fastembed default temp dir.
BOXMIND_EMBEDDING_CACHE_DIR=

# ── Auth ──
# MUST be overridden in any deployment that is reachable by others.
BOXMIND_JWT_SECRET=change-me

# ── Email login codes ──
# Leave SMTP_HOST empty for dev mode: the code is returned by /api/auth/request-code instead of emailed.
BOXMIND_SMTP_HOST=
BOXMIND_SMTP_PORT=587
BOXMIND_SMTP_USER=
BOXMIND_SMTP_PASSWORD=
BOXMIND_SMTP_FROM=

# App Store review demo account: this email gets no mail and signs in with the fixed code.
# Both must be set for it to be active. Use a long random code.
BOXMIND_REVIEW_EMAIL=
BOXMIND_REVIEW_CODE=
